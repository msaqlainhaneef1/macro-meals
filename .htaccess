# ============================================================
# Macro & Meals — Apache Configuration
# Domain: macroandmeals.com | HTTPS + non-www canonical
# ============================================================

# ── Custom Error Pages ──────────────────────────────────────
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html

# ── Directory Settings ──────────────────────────────────────
DirectoryIndex index.html
Options -Indexes -MultiViews +FollowSymLinks
ServerSignature Off

# ============================================================
# REDIRECTS — Single canonical version: https://macroandmeals.com
# ============================================================
RewriteEngine On
RewriteBase /

# Force HTTPS + remove www in ONE redirect (no redirect chains)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.macroandmeals\.com$ [NC]
RewriteRule ^(.*)$ https://macroandmeals.com/$1 [R=301,L]

# Add trailing slash to paths that are not real files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.(txt|xml|json|css|js|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|otf|webmanifest)$ [NC]
RewriteRule ^(.+)$ /$1/ [R=301,L]

# ============================================================
# SECURITY HEADERS
# ============================================================
<IfModule mod_headers.c>
  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Clickjacking protection — only allow framing from same origin
  Header always set X-Frame-Options "SAMEORIGIN"

  # XSS filter (legacy browsers)
  Header always set X-XSS-Protection "1; mode=block"

  # Control referrer information
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy — minimal restrictions
  Header always set Permissions-Policy "interest-cohort=()"

  # Content Security Policy — allow Google Analytics, GTM, AdSense, fonts
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://pagead2.googlesyndication.com https://adservice.google.com https://tpc.googlesyndication.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com https://pagead2.googlesyndication.com https://*.doubleclick.net; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://pagead2.googlesyndication.com https://api.nal.usda.gov https://world.openfoodfacts.org; frame-src 'self' https://www.googletagmanager.com https://tpc.googlesyndication.com https://googleads.g.doubleclick.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"

  # Strict Transport Security — force HTTPS for 1 year + subdomains
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Prevent search engines from caching sensitive headers
  Header always set X-Permitted-Cross-Domain-Policies "none"

  # Remove server software info (if exposed)
  Header always unset X-Powered-By
  Header always unset Server

  # LLM Discoverability — HTTP Link headers (llmstxt.org standard)
  Header always set Link "</llms.txt>; rel=\"alternate\"; type=\"text/plain\"; title=\"LLM Summary\", </llms-full.txt>; rel=\"alternate\"; type=\"text/plain\"; title=\"LLM Full Reference\""

</IfModule>

# ============================================================
# GZIP / BROTLI COMPRESSION
# ============================================================
<IfModule mod_deflate.c>
  # Compress text-based resources
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2

  # Don't compress already-compressed files
  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|ico|woff2?|mp4|zip|gz|bz2)$ no-gzip dont-vary

  # Fix browser bugs with compression
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
  Header append Vary User-Agent env=!dont-vary
</IfModule>

# Brotli compression (if supported — faster + smaller than GZIP)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/xml text/xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
  AddOutputFilterByType BROTLI_COMPRESS application/xhtml+xml
  AddOutputFilterByType BROTLI_COMPRESS font/ttf font/otf font/woff font/woff2
</IfModule>

# ============================================================
# BROWSER CACHING — Aggressive for static, short for HTML
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML — short cache (content changes frequently)
  ExpiresByType text/html "access plus 1 hour"

  # CSS & JavaScript — long cache (versioned via build)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images — long cache
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

  # Fonts — long cache
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

  # Data files — medium cache
  ExpiresByType application/json "access plus 1 week"
  ExpiresByType application/xml "access plus 1 week"
  ExpiresByType text/xml "access plus 1 week"

  # Manifest & feeds
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType application/rss+xml "access plus 1 hour"
  ExpiresByType application/atom+xml "access plus 1 hour"
</IfModule>

# Cache-Control headers for fine-grained control
<IfModule mod_headers.c>
  # HTML — no-cache (revalidate every time)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Static assets — immutable long cache
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|avif|gif|ico|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # JSON data — medium cache
  <FilesMatch "\.(json)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# ============================================================
# MIME TYPES — Ensure correct content types
# ============================================================
<IfModule mod_mime.c>
  AddType text/html .html .htm
  AddType text/css .css
  AddType application/javascript .js
  AddType application/json .json
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType font/ttf .ttf
  AddType font/otf .otf
  AddType application/manifest+json .webmanifest
  AddType image/x-icon .ico

  # Encoding for compressed SVG
  AddEncoding gzip .svgz
</IfModule>

# ============================================================
# CHARSET — UTF-8 everywhere
# ============================================================
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js .json .xml .svg .txt .webmanifest
</IfModule>

# ============================================================
# HOTLINK PROTECTION — Prevent other sites from using your images
# ============================================================
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_REFERER} !^$ [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?macroandmeals\.com [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?google\. [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?bing\. [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?pinterest\. [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?facebook\. [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?twitter\. [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?reddit\. [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?linkedin\. [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?whatsapp\. [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?t\.co [NC]
  RewriteRule \.(jpg|jpeg|png|gif|webp|avif|svg)$ - [F,L]
</IfModule>

# ============================================================
# FILE ACCESS PROTECTION — Block sensitive files
# ============================================================

# Block access to hidden files (.env, .git, .htpasswd, etc.)
# Allow .well-known/ for standard discovery paths (llms.txt, etc.)
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
  RewriteRule (^\.|/\.) - [F]
</IfModule>

# Block server-side scripts and sensitive config files
<FilesMatch "\.(py|pyc|pyo|md|log|yml|yaml|toml|ini|cfg|bak|sql|sh|env)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Block only sensitive JSON paths (allow JSON globally for structured data, APIs)
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} ^/(private|config|_build)/.*\.json$ [NC]
  RewriteRule .* - [F,L]
</IfModule>

# Allow specific public files that are needed
<FilesMatch "^(robots\.txt|sitemap\.xml|sitemap\.php|site\.webmanifest|ads\.txt|app-ads\.txt|llms\.txt|llms-full\.txt)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</FilesMatch>

# Block access to component files (internal use only)
<IfModule mod_rewrite.c>
  RewriteRule ^components/ - [F,L]
</IfModule>

# Block access to build tools directory
<IfModule mod_rewrite.c>
  RewriteRule ^_build/ - [F,L]
</IfModule>

# Block access to Makefile and README at root
<FilesMatch "^(Makefile|README\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# ============================================================
# LLM DISCOVERABILITY — .well-known redirect
# ============================================================
<IfModule mod_rewrite.c>
  # .well-known/llms.txt → /llms.txt (standard discovery path)
  RewriteRule ^\.well-known/llms\.txt$ /llms.txt [L]
  RewriteRule ^\.well-known/llms-full\.txt$ /llms-full.txt [L]
</IfModule>

# ============================================================
# SEO — Clean URLs
# ============================================================
<IfModule mod_rewrite.c>
  # Redirect /page.html → /page/ (external redirect)
  RewriteCond %{REQUEST_URI} \.html$
  RewriteCond %{REQUEST_URI} !^/404\.html$
  RewriteCond %{REQUEST_URI} !/index\.html$
  RewriteRule ^(.+)\.html$ /$1/ [R=301,L]

  # Internally map /page/ → page.html (supports nested URLs like /blog/post/)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}index.html -f [OR]
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.+?)/$ $1.html [L]
</IfModule>

# ============================================================
# PERFORMANCE — ETags and Keep-Alive
# ============================================================

# Disable ETags (avoids caching inconsistencies across CDNs)
FileETag None
Header unset ETag


# ============================================================
# SPAM & BOT PROTECTION
# ============================================================
<IfModule mod_rewrite.c>
  # Block known spam/malicious bots only (search engines + SEO audit tools allowed)
  RewriteCond %{HTTP_USER_AGENT} (Xenu|Zeus|Morfeus|spbot|linkfluence) [NC]
  RewriteRule .* - [F,L]

  # Block empty user agents (usually bots)
  RewriteCond %{HTTP_USER_AGENT} ^$ [NC]
  RewriteCond %{REQUEST_URI} !^/api/ [NC]
  RewriteRule .* - [F,L]
</IfModule>

# ============================================================
# PREVENT COMMON EXPLOITS
# ============================================================
<IfModule mod_rewrite.c>
  # Block SQL injection attempts (strict patterns to avoid false positives)
  RewriteCond %{QUERY_STRING} (union.*select|select.*from|insert.*into|drop.*table|delete.*from|update.*set) [NC]
  RewriteRule .* - [F,L]

  # Block base64 encoded content in query strings
  RewriteCond %{QUERY_STRING} base64_encode.*\(.*\) [NC]
  RewriteRule .* - [F,L]

  # Block script tags in query strings
  RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC]
  RewriteRule .* - [F,L]

  # Block PHP globals manipulation
  RewriteCond %{QUERY_STRING} GLOBALS(=|[|%[0-9A-Z]{0,2}) [NC]
  RewriteRule .* - [F,L]

  # Block _REQUEST manipulation
  RewriteCond %{QUERY_STRING} _REQUEST(=|[|%[0-9A-Z]{0,2}) [NC]
  RewriteRule .* - [F,L]
</IfModule>

# ============================================================
# CORS — Allow fonts and API access
# ============================================================
<IfModule mod_headers.c>
  # Allow cross-origin font loading
  <FilesMatch "\.(woff|woff2|ttf|otf|eot|svg)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # Allow API access from same domain
  <FilesMatch "\.php$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type"
  </FilesMatch>
</IfModule>
